{
  "compilerOptions": {
    "types": [
      "node",
      "vitest/globals"
    ],
    "baseUrl": ".",
    "declaration": true,
    "skipLibCheck": true,
    "target": "ES2023",
    "module": "nodenext",
    "outDir": "lib",
    "rootDir": "./",
    "moduleResolution": "NodeNext",
    "sourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": "lib/.tsbuildinfo",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "typeRoots": [
      "./src/types",
      "./node_modules/@types",
      "./node_modules"
    ],
    "paths": {
      "@tests/*": [
        "tests/*",
        "src/__tests__/__utils__/*"
      ]
    }
  },
  "include": [
    "src/*.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".vscode/**/*"
  ]
}