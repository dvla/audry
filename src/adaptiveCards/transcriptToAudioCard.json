{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.6",
  "body": [
    {
      "type": "Container",
      "style": "default",
      "bleed": true,
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "✅",
                  "size": "Large"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Audio Generated Successfully!",
                  "weight": "Bolder",
                  "size": "Medium",
                  "color": "Default",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "Audio File Path:",
                  "weight": "bolder"
                },
                {
                  "type": "TextBlock",
                  "text": "${audioFilePath}",
                  "wrap": true
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
