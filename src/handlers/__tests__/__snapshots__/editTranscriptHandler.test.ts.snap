                      },
                    ],
                    "type": "Column",
                    "width": "auto",
                  },
                  {
                    "items": [
                      {
                        "color": "Default",
                        "size": "Medium",
                        "text": "Choose your preferred transcript",
                        "type": "TextBlock",
                        "weight": "Bolder",
                        "wrap": true,
                      },
                      {
                        "pages": [
                          {
                            "items": [
                              {
                                "id": "truncatedText_0",
                                "maxLines": 5,
                                "text": "Only original transcript content",
                                "type": "TextBlock",
                                "wrap": true,
                              },
                              {
                                "id": "fullText_0",
                                "isVisible": false,
                                "text": "Only original transcript content",
                                "type": "TextBlock",
                                "wrap": true,
                              },
                              {
                                "id": "showMore_0",
                                "inlines": [
                                  {
                                    "selectAction": {
                                      "targetElements": [
                                        "truncatedText_0",
                                        "fullText_0",
