exports[`EditTranscriptHandler > handleInvoked > should handle single transcript 1`] = `
[MockFunction spy] {
  "calls": [
    [
      {
        "body": [
          {
            "bleed": true,
            "items": [
              {
                "columns": [
                  {
                    "items": [
                      {
                        "size": "Large",
                        "text": "✅",
