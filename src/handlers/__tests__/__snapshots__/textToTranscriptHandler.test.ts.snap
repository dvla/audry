exports[`TextToTranscriptHandler > should send error card if transcript generation fails 1`] = `
{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "body": [
    {
      "bleed": true,
      "items": [
        {
          "columns": [
            {
              "items": [
                {
                  "size": "Large",
                  "text": "⚠️",
                  "type": "TextBlock",
                },
              ],
              "type": "Column",
              "width": "auto",
            },
            {
              "items": [
                {
                  "color": "Default",
                  "size": "Medium",
                  "text": "The transcript could not be generated. Please try again later.",
                  "type": "TextBlock",
