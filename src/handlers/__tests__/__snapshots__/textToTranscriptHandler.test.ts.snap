                  "wrap": true,
                },
              ],
              "type": "Column",
              "width": "stretch",
            },
          ],
          "type": "ColumnSet",
        },
      ],
      "style": "warning",
      "type": "Container",
    },
  ],
  "type": "AdaptiveCard",
  "version": "1.6",
}
`;
