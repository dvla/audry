exports[`UploadFileCommandHandler > should handle valid PDF file upload 1`] = `
{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "body": [
    {
      "bleed": true,
      "items": [
        {
          "columns": [
            {
              "items": [
                {
                  "size": "Large",
                  "text": "✅",
                  "type": "TextBlock",
                },
              ],
              "type": "Column",
              "width": "auto",
            },
            {
              "items": [
                {
                  "color": "Default",
                  "size": "Medium",
                  "text": "Text Extracted",
                  "type": "TextBlock",
                  "weight": "Bolder",
                  "wrap": true,
                },
                {
                  "text": "Extracted text from 3 page(s).",
                  "type": "TextBlock",
                  "wrap": true,
                },
              ],
              "type": "Column",
              "width": "stretch",
            },
          ],
          "type": "ColumnSet",
        },
      ],
      "style": "default",
      "type": "Container",
    },
    {
      "actions": [
        {
          "style": "positive",
          "title": "Text to Transcript",
          "type": "Action.Execute",
          "verb": "textToTranscript",
        },
      ],
      "type": "ActionSet",
    },
  ],
  "type": "AdaptiveCard",
  "version": "1.6",
}
`;

