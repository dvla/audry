exports[`UploadFileCommandHandler > should handle invalid config (safeParse fails) and send warning instead of updating card 1`] = `
[MockFunction warningCard] {
  "calls": [
    [
      "Invalid episode configuration. Please check your input.",
    ],
  ],
  "results": [
    {
      "type": "return",
      "value": {
        "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
        "body": [
          {
            "bleed": true,
            "items": [
              {
                "columns": [
                  {
                    "items": [
                      {
                        "size": "Large",
                        "text": "⚠️",
                        "type": "TextBlock",
                      },
                    ],
                    "type": "Column",
                    "width": "auto",
                  },
                  {
                    "items": [
                      {
                        "color": "Default",
                        "size": "Medium",
                        "text": "Invalid episode configuration. Please check your input.",
                        "type": "TextBlock",
                        "weight": "Bolder",
                        "wrap": true,
                      },
                    ],
                    "type": "Column",
                    "width": "stretch",
                  },
                ],
                "type": "ColumnSet",
              },
            ],
            "style": "warning",
            "type": "Container",
          },
        ],
        "type": "AdaptiveCard",
        "version": "1.6",
      },
    },
  ],
}
`;

