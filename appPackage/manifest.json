{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "Emerging Tech labs",
    "websiteUrl": "https://dvla.sharepoint.com/sites/TechLab",
    "privacyUrl": "https://dvla.sharepoint.com/sites/TechLab",
    "termsOfUseUrl": "https://dvla.sharepoint.com/sites/TechLab"
  },
  "icons": {
    "color": "podcast-${{APP_NAME_SUFFIX}}.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Audry",
    "full": "Audry Podcast Generator"
  },
  "description": {
    "short": "Upload a file to turn content into audio.${{APP_NAME_SUFFIX}}",
    "full": "Easily convert your files into immersive podcast style audio in just a few simple steps. Upload your document and we'll seamlessly transform it into high quality spoken word."
  },
  "accentColor": "#FFFFFF",
  "bots": [
    {
      "botId": "${{BOT_ID}}",
      "scopes": ["personal"],
      "supportsFiles": true,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal"],
          "commands": [
            {
              "title": "Help",
              "description": "Type 'help' if you need instructions."
            }
          ]
        }
      ]
    }
  ],
  "composeExtensions": [],
  "configurableTabs": [],
  "staticTabs": [],
  "permissions": ["identity"],
  "validDomains": [],
  "webApplicationInfo": {
    "id": "${{BOT_ID}}"
  }
}
