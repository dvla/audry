{
    "name": "audry",
    "version": "1.13.9",
    "description": "Microsoft 365 Agents Toolkit Workflow Bot Sample",
    "engines": {
        "node": ">=24.13.0",
        "pnpm": ">=10.30.0",
        "npm": "please-use-pnpm"
    },
    "private": true,
    "author": "DVLA",
    "license": "MIT",
    "main": "./lib/src/index.js",
    "pnpm": {
        "auditConfig": {
            "ignoreCves": [
                "CVE-2020-28500"
            ]
        },
        "overrides": {
            "@langchain/langgraph-api": "npm:@langchain/langgraph-api@*",
            "@langchain/langgraph-ui": "npm:@langchain/langgraph-ui@*",
            "create-langgraph": "npm:create-langgraph@*"
        }
    },
    "scripts": {
        "dev:teamsfx": "env-cmd --silent -f .localConfigs pnpm dev",
        "install:pnpm": "pnpm install",
        "dev": "nodemon --watch ./src --exec node --inspect=9239 --signal SIGINT -r ts-node/register ./src/index.ts",
        "build": "tsc --build && shx cp -r ./src/adaptiveCards ./lib/src && shx cp -r ./src/api/static ./lib/ && shx cp -rn ./src/audio ./lib/src",
        "start": "node ./lib/src/index.js",
        "api:dev": "tsx watch src/api/index.ts",
        "api": "node ./lib/src/api/index.js",
        "graph": "langgraphjs dev --port 2024 --config langgraph.json",
        "watch": "nodemon --watch ./src --exec \"pnpm start\"",
        "prettier": "prettier . -c --log-level=warn --no-error-on-unmatched-pattern",
        "prettier:fix": "prettier . -w --log-level=warn --no-error-on-unmatched-pattern",
        "lint": "eslint . --ext .ts,.js",
        "lint:fix": "eslint . --ext .ts,.js --fix",
        "outdated": "pnpm outdated || true",
        "check": "pnpm build && pnpm lint && pnpm prettier && pnpm test && pnpm audit && pnpm run outdated",
        "test": "vitest run --coverage",
        "release": "semantic-release"
    },
    "dependencies": {
        "@azure-rest/ai-document-intelligence": "1.1.0",
        "@azure/app-configuration-provider": "2.4.0",
        "@azure/identity": "^4.13.0",
        "@azure/monitor-opentelemetry": "1.16.0",
        "@azure/opentelemetry-instrumentation-azure-sdk": "1.0.0-beta.9",
        "@azure/storage-blob": "^12.31.0",
        "@elevenlabs/elevenlabs-js": "2.38.1",
        "@google/genai": "1.44.0",
        "@hono/node-server": "1.19.11",
        "@hono/zod-validator": "^0.7.6",
        "@langchain/core": "1.1.31",
        "@langchain/google-genai": "2.1.24",
        "@langchain/langgraph": "1.2.1",
        "@microsoft/feature-management": "2.2.0",
        "@microsoft/teams-ai": "1.7.4",
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/instrumentation": "^0.213.0",
        "@opentelemetry/resources": "^2.6.0",
        "@opentelemetry/sdk-trace-node": "^2.6.0",
        "@opentelemetry/semantic-conventions": "^1.40.0",
        "adaptive-expressions": "4.23.3",
        "adaptivecards-templating": "2.3.1",
        "botbuilder": "4.23.3",
        "botbuilder-azure": "4.23.3",
        "dotenv": "17.3.1",
        "express": "5.2.1",
        "hono": "4.12.5",
        "microsoft-cognitiveservices-speech-sdk": "1.48.0",
        "uuid": "13.0.0",
        "wav": "1.0.2",
        "winston": "3.19.0",
        "zod": "4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@langchain/langgraph-cli": "^1.1.15",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/express": "^5.0.6",
        "@types/json-schema": "^7.0.15",
        "@types/node": "^25.3.5",
        "@typescript-eslint/eslint-plugin": "^8.56.1",
        "@typescript-eslint/parser": "^8.56.1",
        "@vitest/coverage-v8": "^4.0.18",
        "@vitest/eslint-plugin": "^1.6.9",
        "conventional-changelog-conventionalcommits": "^9.3.0",
        "env-cmd": "^11.0.0",
        "eslint": "^10.0.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.5",
        "music-metadata": "^11.12.1",
        "nodemon": "^3.1.14",
        "npm-audit-resolver": "3.0.0-RC.0",
        "npm-check-updates": "^19.6.3",
        "prettier": "^3.8.1",
        "semantic-release": "^25.0.3",
        "shx": "^0.4.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1",
        "vitest": "^4.0.18"
    }
}
