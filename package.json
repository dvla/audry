{
    "name": "audry",
    "version": "1.3.0",
    "description": "Microsoft 365 Agents Toolkit Workflow Bot Sample",
    "engines": {
        "node": ">=22.21.1"
    },
    "private": true,
    "author": "DVLA",
    "license": "MIT",
    "main": "./lib/src/index.js",
    "scripts": {
        "dev:teamsfx": "env-cmd --silent -f .localConfigs npm run dev",
        "dev": "nodemon --watch ./src --exec node --inspect=9239 --signal SIGINT -r ts-node/register ./src/index.ts",
        "build": "tsc --build && shx cp -r ./src/adaptiveCards ./lib/src && shx cp -r ./src/api/static ./lib/ && shx cp -rn ./src/audio ./lib/src",
        "start": "node ./lib/src/index.js",
        "api:dev": "tsx watch src/api/index.ts",
        "api": "node ./lib/src/api/index.js",
        "graph": "npx @langchain/langgraph-cli dev --port 2024 --config langgraph.json",
        "watch": "nodemon --watch ./src --exec \"npm run start\"",
        "prettier": "prettier . -c --log-level=warn --no-error-on-unmatched-pattern",
        "prettier:fix": "prettier . -w --log-level=warn --no-error-on-unmatched-pattern",
        "lint": "eslint . --ext .ts,.js",
        "lint:fix": "eslint . --ext .ts,.js --fix",
        "audit": "check-audit --registry=https://registry.npmjs.org",
        "resolve-audit": "resolve-audit --registry=https://registry.npmjs.org",
        "outdated": "ncu --errorLevel 2 --color -x npm-audit-resolver,eslint*",
        "check": "npm run build && npm run lint && npm run prettier && npm run test && npm run audit && npm run outdated",
        "test": "vitest run --coverage",
        "release": "semantic-release"
    },
    "dependencies": {
        "@azure-rest/ai-document-intelligence": "1.1.0",
        "@azure/app-configuration-provider": "2.2.0",
        "@azure/monitor-opentelemetry": "1.14.2",
        "@elevenlabs/elevenlabs-js": "2.24.1",
        "@google/genai": "1.30.0",
        "@hono/node-server": "1.19.6",
        "@langchain/core": "0.3.79",
        "@langchain/google-genai": "0.2.18",
        "@langchain/langgraph": "0.4.9",
        "@microsoft/feature-management": "2.2.0",
        "@microsoft/teams-ai": "1.7.4",
        "adaptive-expressions": "4.23.3",
        "adaptivecards-templating": "2.3.1",
        "botbuilder": "4.23.3",
        "botbuilder-azure": "4.23.3",
        "dotenv": "17.2.3",
        "express": "5.1.0",
        "hono": "4.10.6",
        "uuid": "13.0.0",
        "wav": "1.0.2",
        "winston": "3.18.3",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@langchain/langgraph-cli": "^0.0.71",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/express": "^5.0.5",
        "@types/json-schema": "^7.0.15",
        "@types/node": "^24.10.1",
        "@typescript-eslint/eslint-plugin": "^8.46.4",
        "@typescript-eslint/parser": "^8.46.4",
        "@vitest/coverage-v8": "^3.2.4",
        "@vitest/eslint-plugin": "^1.4.3",
        "conventional-changelog-conventionalcommits": "^9.1.0",
        "env-cmd": "^11.0.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-config-standard": "^17.1.0",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.4",
        "music-metadata": "^11.10.1",
        "nodemon": "^3.1.11",
        "npm-audit-resolver": "^3.0.0-RC.0",
        "npm-check-updates": "^19.1.2",
        "prettier": "^3.6.2",
        "semantic-release": "^25.0.2",
        "shx": "^0.4.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    }
}
