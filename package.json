{
    "name": "audry",
    "version": "1.0.0",
    "description": "Microsoft 365 Agents Toolkit Workflow Bot Sample",
    "engines": {
        "node": ">=22"
    },
    "author": "DVLA",
    "license": "MIT",
    "main": "./lib/src/index.js",
    "scripts": {
        "dev:teamsfx": "env-cmd --silent -f .localConfigs npm run dev",
        "dev:teamsfx:testtool": "env-cmd --silent -f .localConfigs.playground npm run dev",
        "dev:teamsfx:launch-testtool": "env-cmd --silent -f env/.env.playground teamsapptester start",
        "dev": "nodemon --watch ./src --exec node --inspect=9239 --signal SIGINT -r ts-node/register ./src/index.ts",
        "build": "tsc --build && shx cp -r ./src/adaptiveCards ./lib/src && shx cp -r ./src/api/static ./lib/",
        "start": "node ./lib/src/index.js",
        "api:dev": "tsx watch src/api/index.ts",
        "api": "node ./lib/src/api/index.js",
        "graph": "npx @langchain/langgraph-cli dev --port 2024 --config langgraph.json",
        "watch": "nodemon --watch ./src --exec \"npm run start\"",
        "prettier": "prettier . -c --log-level=warn --no-error-on-unmatched-pattern",
        "prettier:fix": "prettier . -w --log-level=warn --no-error-on-unmatched-pattern",
        "lint": "eslint . --ext .ts,.js",
        "lint:fix": "eslint . --ext .ts,.js --fix",
        "audit": "check-audit --registry=https://registry.npmjs.org",
        "resolve-audit": "resolve-audit --registry=https://registry.npmjs.org",
        "outdated": "ncu --errorLevel 2 --color -x npm-audit-resolver,eslint*",
        "check": "npm run build && npm run lint && npm run prettier && npm run test && npm run audit && npm run outdated",
        "test": "vitest run --coverage"
    },
    "dependencies": {
        "@azure-rest/ai-document-intelligence": "^1.1.0",
        "@azure/app-configuration-provider": "^2.1.0",
        "@elevenlabs/elevenlabs-js": "^2.15.0",
        "@google/genai": "^1.12.0",
        "@hono/node-server": "^1.19.1",
        "hono": "^4.9.6",
        "@langchain/core": "^0.3.66",
        "@langchain/google-genai": "^0.2.16",
        "@langchain/langgraph": "^0.4.2",
        "@microsoft/feature-management": "^2.1.0",
        "@microsoft/teams-ai": "^1.7.4",
        "adaptive-expressions": "^4.23.2",
        "adaptivecards-templating": "^2.3.1",
        "botbuilder": "^4.23.2",
        "botbuilder-azure": "^4.23.2",
        "dotenv": "^16.4.7",
        "express": "^5.1.0",
        "uuid": "^11.1.0",
        "wav": "^1.0.2",
        "winston": "^3.17.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@eslint/js": "^9.31.0",
        "@langchain/langgraph-cli": "^0.0.57",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/express": "^5.0.3",
        "@types/json-schema": "^7.0.15",
        "@types/node": "^24.1.0",
        "@typescript-eslint/eslint-plugin": "^8.38.0",
        "@typescript-eslint/parser": "^8.38.0",
        "@vitest/coverage-v8": "^3.2.4",
        "@vitest/eslint-plugin": "^1.3.4",
        "env-cmd": "^10.1.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-config-standard": "^17.1.0",
        "eslint-import-resolver-typescript": "^4.4.1",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-prettier": "^5.4.0",
        "nodemon": "^3.1.10",
        "npm-audit-resolver": "^3.0.0-RC.0",
        "npm-check-updates": "^18.0.2",
        "prettier": "^3.6.2",
        "shx": "^0.3.4",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    }
}
