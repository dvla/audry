{
    "name": "audry",
    "version": "1.7.4",
    "description": "Microsoft 365 Agents Toolkit Workflow Bot Sample",
    "engines": {
        "node": ">=22.21.1",
        "pnpm": ">=10.23.0",
        "npm": "please-use-pnpm"
    },
    "private": true,
    "author": "DVLA",
    "license": "MIT",
    "main": "./lib/src/index.js",
    "pnpm": {
        "auditConfig": {
            "ignoreCves": [
                "CVE-2020-28500"
            ]
        },
        "overrides": {
            "zod": "<4"
        }
    },
    "scripts": {
        "dev:teamsfx": "env-cmd --silent -f .localConfigs pnpm dev",
        "install:pnpm": "pnpm install",
        "dev": "nodemon --watch ./src --exec node --inspect=9239 --signal SIGINT -r ts-node/register ./src/index.ts",
        "build": "tsc --build && shx cp -r ./src/adaptiveCards ./lib/src && shx cp -r ./src/api/static ./lib/ && shx cp -rn ./src/audio ./lib/src",
        "start": "node ./lib/src/index.js",
        "api:dev": "tsx watch src/api/index.ts",
        "api": "node ./lib/src/api/index.js",
        "graph": "pnpx @langchain/langgraph-cli dev --port 2024 --config langgraph.json",
        "watch": "nodemon --watch ./src --exec \"pnpm start\"",
        "prettier": "prettier . -c --log-level=warn --no-error-on-unmatched-pattern",
        "prettier:fix": "prettier . -w --log-level=warn --no-error-on-unmatched-pattern",
        "lint": "eslint . --ext .ts,.js",
        "lint:fix": "eslint . --ext .ts,.js --fix",
        "outdated": "pnpm outdated || true",
        "check": "pnpm build && pnpm lint && pnpm prettier && pnpm test && pnpm audit && pnpm run outdated",
        "test": "vitest run --coverage",
        "release": "semantic-release"
    },
    "dependencies": {
        "@azure-rest/ai-document-intelligence": "1.1.0",
        "@azure/app-configuration-provider": "2.2.0",
        "@azure/identity": "^4.13.0",
        "@azure/monitor-opentelemetry": "1.14.2",
        "@elevenlabs/elevenlabs-js": "2.27.0",
        "@google/genai": "1.32.0",
        "@hono/node-server": "1.19.7",
        "@azure/opentelemetry-instrumentation-azure-sdk": "1.0.0-beta.9",
        "@azure/storage-blob": "^12.29.1",
        "@hono/zod-validator": "^0.7.5",
        "@langchain/core": "0.3.79",
        "@langchain/google-genai": "0.2.18",
        "@langchain/langgraph": "0.4.9",
        "@microsoft/feature-management": "2.2.0",
        "@microsoft/teams-ai": "1.7.4",
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/instrumentation": "^0.208.0",
        "@opentelemetry/resources": "^2.2.0",
        "@opentelemetry/sdk-trace-node": "^2.2.0",
        "@opentelemetry/semantic-conventions": "^1.38.0",
        "adaptive-expressions": "4.23.3",
        "adaptivecards-templating": "2.3.1",
        "botbuilder": "4.23.3",
        "botbuilder-azure": "4.23.3",
        "dotenv": "17.2.3",
        "express": "5.2.1",
        "hono": "4.10.7",
        "uuid": "13.0.0",
        "wav": "1.0.2",
        "winston": "3.19.0",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@langchain/langgraph-cli": "^0.0.71",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/express": "^5.0.6",
        "@types/json-schema": "^7.0.15",
        "@types/node": "^24.10.2",
        "@typescript-eslint/eslint-plugin": "^8.49.0",
        "@typescript-eslint/parser": "^8.49.0",
        "@vitest/coverage-v8": "^3.2.4",
        "@vitest/eslint-plugin": "^1.5.2",
        "conventional-changelog-conventionalcommits": "^9.1.0",
        "env-cmd": "^11.0.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-config-standard": "^17.1.0",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.4",
        "music-metadata": "^11.10.3",
        "nodemon": "^3.1.11",
        "npm-audit-resolver": "^3.0.0-RC.0",
        "npm-check-updates": "^19.1.2",
        "prettier": "^3.7.4",
        "prettier": "^3.6.2",
        "semantic-release": "^25.0.2",
        "shx": "^0.4.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    }
}